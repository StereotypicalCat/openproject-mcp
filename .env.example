# ==============================================================================
# OpenProject Docker & MCP Server Environment Configuration
# ==============================================================================

# OpenProject Docker Image Tag (Targeting OpenProject 17)
TAG=17-slim

# Local exposed port on the host
PORT=8080

# Database Configuration
POSTGRES_VERSION=17
POSTGRES_PASSWORD=p4ssw0rd

# OpenProject Application Configuration
OPENPROJECT_HOST__NAME=localhost:8080
OPENPROJECT_HTTPS=false
SECRET_KEY_BASE=openproject-secret-key-base-for-local-testing-at-least-64-characters-long

# MCP Server Client Configuration
# Once the container is running and seeded via scripts/seed.sh,
# OPENPROJECT_API_KEY will be automatically written to .env.test
OPENPROJECT_BASE_URL=http://localhost:8080
OPENPROJECT_API_KEY=
